# 环境配置示例文件
# 复制此文件为 .env 并填入实际值

# ===== 数据库配置 =====
DATABASE_URL=postgresql://user:password@localhost:5432/multi_agent_dev
# 或使用SQLite（开发环境）
# DATABASE_URL=sqlite:///./multi_agent_dev.db

# ===== Redis配置（可选，用于分布式锁和缓存） =====
REDIS_URL=redis://localhost:6379/0

# ===== LLM API配置 =====
# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_API_BASE=https://api.anthropic.com

# OpenAI API（可选）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# 本地Ollama（可选）
OLLAMA_BASE_URL=http://localhost:11434

# ===== JWT认证配置 =====
JWT_SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ===== 应用配置 =====
APP_NAME=Multi-Agent Development System
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# API服务器配置
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# CORS配置
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== Celery配置（异步任务） =====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== 文件存储配置 =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=104857600  # 100MB

# ===== 监控配置 =====
PROMETHEUS_PORT=9090
ENABLE_METRICS=true

# ===== 备份配置 =====
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_HOUR=2  # 凌晨2点自动备份

# ===== 成本配置 =====
# Claude定价（每百万token）
CLAUDE_SONNET_INPUT_PRICE=3.0
CLAUDE_SONNET_OUTPUT_PRICE=15.0
CLAUDE_OPUS_INPUT_PRICE=15.0
CLAUDE_OPUS_OUTPUT_PRICE=75.0

# OpenAI定价（每百万token）
GPT4_INPUT_PRICE=30.0
GPT4_OUTPUT_PRICE=60.0

# 成本预警阈值（美元）
COST_ALERT_THRESHOLD=100.0

# ===== 安全配置 =====
# 速率限制
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# 会话超时（秒）
SESSION_TIMEOUT=3600

# 密码策略
MIN_PASSWORD_LENGTH=8
REQUIRE_SPECIAL_CHAR=true

# ===== 多语言配置 =====
DEFAULT_LANGUAGE=en-US
SUPPORTED_LANGUAGES=zh-CN,en-US,ja-JP,ko-KR,fr-FR,de-DE,es-ES,ru-RU,ar-SA,pt-BR

# ===== Git配置（项目导入） =====
GIT_CLONE_TIMEOUT=300
GIT_CLONE_DIR=./git_repos

# ===== 开发配置 =====
# 是否启用热重载
RELOAD=true

# 是否启用调试模式
DEBUG_SQL=false

# 测试模式
TESTING=false
