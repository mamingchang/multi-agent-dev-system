# Multi-Agent Dev System Configuration

# Claude API (可选，用于AI Agent)
# 获取: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# 数据库
DATABASE_URL=sqlite:///./multi_agent_dev.db

# JWT认证 (生产环境请更改SECRET_KEY)
SECRET_KEY=dev-secret-key-change-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 服务器
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# CORS (开发环境)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
